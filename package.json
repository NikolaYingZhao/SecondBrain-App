{
  "name": "secondbrain-v2",
  "version": "0.1.0",
  "description": "A private desktop reader and search interface for a Markdown-based second brain.",
  "author": "Nikola Ying Zhao",
  "private": true,
  "type": "module",
  "main": "src/desktop.mjs",
  "scripts": {
    "audit": "node src/cli.mjs audit",
    "build": "node src/cli.mjs build",
    "start": "electron .",
    "web": "node src/server.mjs",
    "test": "node --test && node scripts/guard-data-branch.mjs",
    "pack": "npm test && electron-builder --win dir",
    "dist": "npm test && electron-builder --win nsis"
  },
  "dependencies": {
    "marked": "^18.0.6",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.secondbrain.desktop",
    "productName": "SecondBrain",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "config/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
