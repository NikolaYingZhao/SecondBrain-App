{
  "name": "secondbrain",
  "version": "1.1.0",
  "description": "A local-first desktop home for a personal knowledge base, with auto-update.",
  "author": "Nikola Ying Zhao",
  "private": true,
  "type": "module",
  "main": "src/desktop.mjs",
  "scripts": {
    "audit": "node src/cli.mjs audit",
    "build": "node src/cli.mjs build",
    "start": "electron .",
    "web": "node src/server.mjs",
    "test": "node --test",
    "pack": "npm test && electron-builder --win dir",
    "dist": "npm test && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "marked": "^18.0.6",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.secondbrain.desktop",
    "productName": "SecondBrain",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "artifactName": "SecondBrain-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "NikolaYingZhao",
      "repo": "SecondBrain-App"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "config/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SecondBrain",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
